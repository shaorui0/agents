{
  "_comment": "Copy the 'hooks' and 'permissions' blocks into your own .claude/settings.json (project) or ~/.claude/settings.json. Replace $REPO with the absolute path of this checkout. Gate 2 is the permissions block; Gate 3 is the PreToolUse k8s_gate hook.",
  "permissions": {
    "allow": [
      "Bash(kdev get:*)",
      "Bash(kdev describe:*)",
      "Bash(kdev logs:*)",
      "Bash(kprod get:*)",
      "Bash(kprod describe:*)",
      "Bash(kprod logs:*)"
    ],
    "deny": [
      "Bash(kubectl delete namespace:*)",
      "Bash(kubectl delete ns:*)",
      "Bash(aws iam:*)",
      "Bash(aws ec2 terminate-instances:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash $REPO/hooks/k8s_gate.sh" },
          { "type": "command", "command": "bash $REPO/hooks/audit_pre.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash $REPO/hooks/audit_log.sh" }
        ]
      }
    ]
  }
}
